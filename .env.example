# ----------------------------------------------------------------------------
# Furmacy — environment variables (ALL optional).
# Copy this file to .env.local and fill in what you need. Never commit secrets;
# .env.local is gitignored. Only NEXT_PUBLIC_* values are exposed to the browser.
#
# This site builds as a fully static export (output: "export") for GitHub Pages,
# so there is no server runtime — every variable below is a build-time
# NEXT_PUBLIC_* value baked into the static output.
# ----------------------------------------------------------------------------

# --- Site / public launch ---------------------------------------------------
# Canonical site origin (used for metadata, canonical URLs, sitemap, OG images).
NEXT_PUBLIC_SITE_URL=https://furmacy.org

# App Store link for the download buttons. Leave blank to show "Coming soon".
NEXT_PUBLIC_APP_STORE_URL=

# Apple numeric app ID — enables the apple-itunes-app smart banner once live.
NEXT_PUBLIC_APPLE_APP_ID=

# Public contact alias shown on the site (forwards to your team inbox).
NEXT_PUBLIC_CONTACT_EMAIL=contact@furmacy.org

# --- Beta intake (/beta) ----------------------------------------------------
# Public TestFlight link shown on the beta success screen. Blank hides it.
NEXT_PUBLIC_TESTFLIGHT_URL=

# The beta intake is submitted client-side via FormSubmit.co (no server is
# needed for the static build). Submissions are emailed to this address; the
# first submission triggers a one-time FormSubmit activation email — click it
# once and submissions start flowing.
NEXT_PUBLIC_FORMSUBMIT_EMAIL=beta@furmacy.org
