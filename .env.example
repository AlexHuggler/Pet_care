# ----------------------------------------------------------------------------
# Furmacy — environment variables (ALL optional).
# Copy this file to .env.local and fill in what you need. Never commit secrets;
# .env.local is gitignored. Only NEXT_PUBLIC_* values are exposed to the browser.
#
# This site builds as a fully static export (output: "export") for GitHub Pages,
# so there is no server runtime — every variable below is a build-time
# NEXT_PUBLIC_* value baked into the static output.
# ----------------------------------------------------------------------------

# --- Site / public launch ---------------------------------------------------
# Canonical site origin (used for metadata, canonical URLs, sitemap, OG images).
NEXT_PUBLIC_SITE_URL=https://furmacy.org

# App Store link for the download buttons. Defaults to the public listing below.
NEXT_PUBLIC_APP_STORE_URL=https://apps.apple.com/us/app/furmacy-pet-med-tracker/id6767069388?uo=4

# Apple numeric app ID — enables the apple-itunes-app smart banner metadata.
NEXT_PUBLIC_APPLE_APP_ID=6767069388

# Optional App Store Connect provider token for /go/<slug>/ campaign links.
# When set, generated App Store URLs include pt, ct, and mt=8 parameters.
NEXT_PUBLIC_APPLE_PROVIDER_TOKEN=

# Public contact alias shown on the site (forwards to your team inbox).
NEXT_PUBLIC_CONTACT_EMAIL=contact@furmacy.org

# --- Legacy /beta route -----------------------------------------------------
# /beta is retained as a noindex handoff page that sends visitors to the public
# App Store listing and contact page.
