# ----------------------------------------------------------------------------
# Furmacy Beta Intake — environment variables (ALL optional).
# Copy this file to .env.local and fill in what you need. Never commit secrets;
# .env.local is gitignored. Only NEXT_PUBLIC_* values are exposed to the browser.
# ----------------------------------------------------------------------------

# Public TestFlight link shown on the success screen ("Want to start now?").
# Safe to expose. Leave blank to hide that section entirely.
NEXT_PUBLIC_TESTFLIGHT_URL=

# --- Submission backend (optional) ------------------------------------------
# Configure ONE provider. With none set, local dev writes each submission to
# ./submissions/*.json so you can inspect responses while building.
# Precedence in app/api/submit/route.ts: webhook -> Formspree -> (Supabase/Airtable).

# Generic webhook / serverless endpoint (Zapier, Make, n8n, your own function...).
SUBMIT_WEBHOOK_URL=

# Formspree form id — the part after /f/ in https://formspree.io/f/<id>
FORMSPREE_FORM_ID=

# --- Supabase (server-only; uncomment the block in route.ts to enable) -------
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_TABLE=furmacy_beta_intake

# --- Airtable (server-only; uncomment the block in route.ts to enable) -------
# AIRTABLE_API_KEY=
# AIRTABLE_BASE_ID=
# AIRTABLE_TABLE=Beta Intake
